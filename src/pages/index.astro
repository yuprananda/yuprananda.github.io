---
import '../styles/global.css';

const linkedIn = 'https://www.linkedin.com/in/yu-prananda-125116449/';
const email = 'hello.yuprananda@gmail.com';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f5f3ec" />
    <meta
      name="description"
      content="Yu Prananda is an independent software engineer building thoughtful full-stack products and practical business automation."
    />
    <meta property="og:title" content="Yu Prananda — Software Engineer" />
    <meta
      property="og:description"
      content="Practical software for the work that matters. Full-stack engineering, business automation, and thoughtful systems."
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://yuprananda.github.io/" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <title>Yu Prananda — Software Engineer</title>
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header">
        <a class="wordmark" href="#top" aria-label="Yu Prananda, home">
          <span class="wordmark-mark">y.</span>
          <span>YU PRANANDA</span>
        </a>
        <nav class="main-nav" aria-label="Main navigation">
          <a href="#work" data-en="Selected work" data-id="Karya pilihan">Selected work</a>
          <a href="#services" data-en="What I do" data-id="Layanan">What I do</a>
          <a href="#about" data-en="About" data-id="Tentang">About</a>
        </nav>
        <div class="header-actions">
          <button class="language-toggle" type="button" aria-label="Switch language to Indonesian" aria-pressed="false">
            <span class="language-code">ID</span>
            <span class="language-divider">/</span>
            <span class="language-code language-code-active">EN</span>
          </button>
          <a class="header-contact" href={`mailto:${email}`}>
            <span data-en="Let's talk" data-id="Mari bicara">Let’s talk</span>
            <span aria-hidden="true">↗</span>
          </a>
        </div>
      </header>

      <main id="top">
        <section class="hero section-wrap" aria-labelledby="hero-title">
          <div class="hero-copy">
            <p class="eyebrow"><span class="status-dot"></span><span data-en="Independent software engineer · Indonesia" data-id="Software engineer independen · Indonesia">Independent software engineer · Indonesia</span></p>
            <h1 id="hero-title">
              <span data-en="Practical software" data-id="Software praktis">Practical software</span><br />
              <span class="hero-title-second" data-en="for the work" data-id="untuk pekerjaan">for the work</span><br />
              <span class="hero-title-third"><span data-en="that matters" data-id="yang berarti">that matters</span><span class="accent-period">.</span></span>
            </h1>
            <div class="hero-bottom">
              <p class="hero-intro" data-en="I design and build full-stack products and business automation that make everyday work clearer, faster, and easier to trust." data-id="Saya merancang dan membangun produk full-stack serta otomasi bisnis yang membuat pekerjaan sehari-hari lebih jelas, cepat, dan dapat diandalkan.">
                I design and build full-stack products and business automation that make everyday work clearer, faster, and easier to trust.
              </p>
              <a class="round-link" href="#work" aria-label="Explore selected work"><span aria-hidden="true">↓</span></a>
            </div>
          </div>

          <div class="hero-art" aria-label="Illustration of a connected business system">
            <div class="art-meta art-meta-top"><span>FIELD NOTES / 001</span><span>BERAU, ID</span></div>
            <div class="orbit orbit-outer"></div>
            <div class="orbit orbit-inner"></div>
            <div class="orbit-axis orbit-axis-one"></div>
            <div class="orbit-axis orbit-axis-two"></div>
            <div class="system-core"><span class="core-glyph">B</span><span class="core-label">BICLESS<br />ERP</span></div>
            <div class="orbit-node node-people"><span class="node-symbol">↗</span><span class="node-label" data-en="PEOPLE" data-id="TIM">PEOPLE</span></div>
            <div class="orbit-node node-records"><span class="node-symbol node-symbol-coral">▤</span><span class="node-label" data-en="RECORDS" data-id="ARSIP">RECORDS</span></div>
            <div class="orbit-node node-workflow"><span class="node-symbol node-symbol-cream">⌘</span><span class="node-label" data-en="WORKFLOW" data-id="ALUR KERJA">WORKFLOW</span></div>
            <div class="art-caption"><span class="caption-line"></span><span data-en="One connected view of daily operations." data-id="Satu tampilan terhubung untuk operasional harian.">One connected view of daily operations.</span></div>
            <div class="art-index">01 — 03</div>
          </div>
          <div class="hero-footnote"><span>YU PRANANDA</span><span>SOFTWARE / SYSTEMS / AUTOMATION</span><span>SCROLL TO EXPLORE ↓</span></div>
        </section>

        <section class="intro-band" aria-label="Introduction">
          <div class="section-wrap intro-band-inner">
            <p class="eyebrow"><span data-en="A thoughtful engineering partner" data-id="Partner engineering yang kolaboratif">A thoughtful engineering partner</span></p>
            <p class="intro-statement" data-en="Good software starts with understanding the problem. I bring product thinking and hands-on engineering together to build useful tools for real operations." data-id="Software yang baik berawal dari memahami masalah. Saya memadukan cara berpikir produk dan kemampuan engineering untuk membangun alat yang berguna bagi operasional nyata.">
              Good software starts with understanding the problem. I bring product thinking and hands-on engineering together to build useful tools for real operations.
            </p>
            <span class="intro-number">01<span>/</span>04</span>
          </div>
        </section>

        <section class="work-section section-wrap" id="work">
          <div class="section-heading">
            <div><p class="eyebrow">01 — <span data-en="SELECTED WORK" data-id="KARYA PILIHAN">SELECTED WORK</span></p><h2 data-en="Built for the real world." data-id="Dibangun untuk dunia nyata.">Built for the real world.</h2></div>
            <p class="section-aside" data-en="A closer look at a system shaped around the people who use it." data-id="Melihat lebih dekat sistem yang dirancang bersama orang-orang yang menggunakannya.">A closer look at a system shaped around the people who use it.</p>
          </div>

          <article class="project-card">
            <div class="project-visual">
              <div class="project-topline"><span>BICLESS ERP</span><span>WORKFORCE / OPERATIONS</span></div>
              <div class="dashboard-window">
                <div class="dashboard-sidebar"><span class="sidebar-brand">b<span>.</span></span><span class="sidebar-item sidebar-item-active">◫</span><span class="sidebar-item">◷</span><span class="sidebar-item">▤</span><span class="sidebar-item">⌁</span></div>
                <div class="dashboard-main">
                  <div class="dashboard-nav"><span data-en="Operations overview" data-id="Ringkasan operasional">Operations overview</span><span class="dashboard-avatar">YP</span></div>
                  <div class="dashboard-welcome"><span data-en="Good morning" data-id="Selamat pagi">Good morning</span><span>✳</span></div>
                  <div class="dashboard-cards">
                    <div class="dash-card dash-card-dark"><span data-en="Workforce" data-id="Tenaga kerja">Workforce</span><strong>↗</strong><span class="dash-card-graphic graphic-bars"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></span></div>
                    <div class="dash-card dash-card-green"><span data-en="Documents" data-id="Dokumen">Documents</span><strong>↗</strong><span class="dash-card-graphic graphic-lines"><i></i><i></i><i></i></span></div>
                    <div class="dash-card dash-card-orange"><span data-en="Leave & requests" data-id="Cuti & permintaan">Leave & requests</span><strong>↗</strong><span class="dash-card-graphic graphic-dots">••••••••••••••••</span></div>
                  </div>
                  <div class="dashboard-table"><span data-en="Recent activity" data-id="Aktivitas terbaru">Recent activity</span><div><i></i><i></i><i></i></div><div><i></i><i></i><i></i></div><div><i></i><i></i><i></i></div></div>
                </div>
              </div>
              <div class="project-visual-note"><span class="visual-note-mark">✳</span><span data-en="Designed around daily operations" data-id="Dirancang untuk operasional harian">Designed around daily operations</span></div>
            </div>
            <div class="project-details">
              <div class="project-number">PROJECT / 01</div>
              <h3>Bicless ERP</h3>
              <p class="project-lede" data-en="A workforce management system built to bring everyday operations into one dependable place." data-id="Sistem manajemen tenaga kerja yang menyatukan operasional sehari-hari dalam satu tempat yang andal.">A workforce management system built to bring everyday operations into one dependable place.</p>
              <div class="project-story">
                <div><span class="detail-label" data-en="THE CHALLENGE" data-id="TANTANGAN">THE CHALLENGE</span><p data-en="People, documents, and routine requests were being managed across spreadsheets and separate files." data-id="Data karyawan, dokumen, dan permintaan rutin dikelola melalui spreadsheet dan berkas yang terpisah.">People, documents, and routine requests were being managed across spreadsheets and separate files.</p></div>
                <div><span class="detail-label" data-en="THE APPROACH" data-id="PENDEKATAN">THE APPROACH</span><p data-en="I independently initiated and developed a practical system for eligibility checks, document management, reminders, leave requests, and operational monitoring." data-id="Saya menginisiasi dan mengembangkan sistem praktis untuk pemeriksaan kelayakan, pengelolaan dokumen, pengingat, pengajuan cuti, dan pemantauan operasional.">I independently initiated and developed a practical system for eligibility checks, document management, reminders, leave requests, and operational monitoring.</p></div>
              </div>
              <div class="project-bottom"><div class="tag-list"><span>Next.js</span><span>TypeScript</span><span>PostgreSQL</span><span>Prisma</span></div><span class="project-status"><i></i><span data-en="In daily use" data-id="Digunakan sehari-hari">In daily use</span></span></div>
            </div>
          </article>
          <p class="work-note"><span>↗</span><span data-en="One focused case study. More of the story is available in conversation." data-id="Satu studi kasus utama. Cerita selengkapnya bisa dibahas bersama.">One focused case study. More of the story is available in conversation.</span></p>
        </section>

        <section class="services-section" id="services">
          <div class="section-wrap services-wrap">
            <div class="section-heading section-heading-light">
              <div><p class="eyebrow">02 — <span data-en="HOW I CAN HELP" data-id="YANG BISA SAYA BANTU">HOW I CAN HELP</span></p><h2><span class="heading-line" data-en="From messy process" data-id="Dari proses rumit">From messy process</span><span class="heading-line" data-en="to useful product." data-id="jadi produk berguna.">to useful product.</span></h2></div>
              <p class="section-aside" data-en="I work across the stack, stay close to the problem, and keep the solution grounded in the way your business runs." data-id="Saya bekerja menyeluruh di seluruh stack, memahami masalah dari dekat, dan menjaga solusi tetap sesuai cara bisnis Anda berjalan.">I work across the stack, stay close to the problem, and keep the solution grounded in the way your business runs.</p>
            </div>
            <div class="service-grid">
              <article class="service-card"><span class="service-index">01</span><div class="service-icon icon-stack"><i></i><i></i><i></i></div><h3 data-en="Full-stack development" data-id="Pengembangan full-stack">Full-stack development</h3><p data-en="Purposeful web applications, from clear interfaces to reliable data foundations." data-id="Aplikasi web yang dirancang dengan cermat, dari antarmuka yang jelas hingga fondasi data yang andal.">Purposeful web applications, from clear interfaces to reliable data foundations.</p><span class="service-arrow">↗</span></article>
              <article class="service-card"><span class="service-index">02</span><div class="service-icon icon-flow"><i></i><i></i><i></i><i></i></div><h3 data-en="Business automation" data-id="Otomasi bisnis">Business automation</h3><p data-en="Less repetitive admin. Better-connected workflows built around how your team actually works." data-id="Kurangi pekerjaan administratif berulang. Hubungkan alur kerja sesuai cara tim Anda bekerja.">Less repetitive admin. Better-connected workflows built around how your team actually works.</p><span class="service-arrow">↗</span></article>
              <article class="service-card"><span class="service-index">03</span><div class="service-icon icon-integration"><i>↗</i><i>↙</i><i>+</i></div><h3 data-en="Systems integration" data-id="Integrasi sistem">Systems integration</h3><p data-en="Bring disconnected tools and information together into a calmer, more useful system." data-id="Satukan perangkat dan informasi yang terpisah menjadi sistem yang lebih sederhana dan berguna.">Bring disconnected tools and information together into a calmer, more useful system.</p><span class="service-arrow">↗</span></article>
            </div>
          </div>
        </section>

        <section class="about-section section-wrap" id="about">
          <div class="about-label"><p class="eyebrow">03 — <span data-en="A LITTLE ABOUT ME" data-id="TENTANG SAYA">A LITTLE ABOUT ME</span></p><div class="about-monogram">Y<span>.</span>P</div><p class="about-location"><span class="location-pin">⌖</span><span data-en="Based in East Kalimantan, Indonesia<br />Working with people everywhere." data-id="Berbasis di Kalimantan Timur, Indonesia<br />Terbuka bekerja dengan tim di mana pun.">Based in East Kalimantan, Indonesia<br />Working with people everywhere.</span></p></div>
          <div class="about-copy">
            <h2 data-en="Curious about the problem. Careful with the solution." data-id="Penasaran pada masalahnya. Cermat merancang solusinya.">Curious about the problem. Careful with the solution.</h2>
            <p data-en="I’m Yu, an independent software engineer based in Indonesia. Since 2021, I’ve worked across full-stack development, business applications, and workflow automation—turning real operational needs into software people can rely on." data-id="Saya Yu, software engineer independen dari Indonesia. Sejak 2021, saya bekerja di pengembangan full-stack, aplikasi bisnis, dan otomasi workflow—menerjemahkan kebutuhan operasional nyata menjadi software yang dapat diandalkan.">I’m Yu, an independent software engineer based in Indonesia. Since 2021, I’ve worked across full-stack development, business applications, and workflow automation—turning real operational needs into software people can rely on.</p>
            <p data-en="I studied Informatics Engineering at Universitas Ngudi Waluyo. I enjoy learning how a business works before deciding what to build, and staying involved from the first conversation through a working solution." data-id="Saya menempuh pendidikan Teknik Informatika di Universitas Ngudi Waluyo. Saya senang memahami cara kerja bisnis sebelum menentukan apa yang perlu dibangun, dan terlibat sejak diskusi awal hingga solusi benar-benar digunakan.">I studied Informatics Engineering at Universitas Ngudi Waluyo. I enjoy learning how a business works before deciding what to build, and staying involved from the first conversation through a working solution.</p>
            <div class="about-tools"><span class="detail-label" data-en="TOOLS I WORK WITH" data-id="TEKNOLOGI YANG SAYA GUNAKAN">TOOLS I WORK WITH</span><div class="tag-list"><span>TypeScript</span><span>React</span><span>Next.js</span><span>PostgreSQL</span><span>Prisma</span></div></div>
          </div>
        </section>

        <section class="contact-section">
          <div class="section-wrap contact-wrap">
            <div><p class="eyebrow">04 — <span data-en="HAVE A PROJECT IN MIND?" data-id="PUNYA PROYEK YANG INGIN DIBAHAS?">HAVE A PROJECT IN MIND?</span></p><h2><span class="heading-line" data-en="Let’s make" data-id="Mari buat">Let’s make</span><span class="heading-line" data-en="work work better." data-id="pekerjaan lebih baik.">work work better.</span></h2></div>
            <div class="contact-aside"><p data-en="Tell me what’s slowing your team down, or what you’ve been wanting to build. I’d love to hear about it." data-id="Ceritakan hal yang memperlambat tim Anda atau ide yang ingin Anda bangun. Saya ingin mendengarnya.">Tell me what’s slowing your team down, or what you’ve been wanting to build. I’d love to hear about it.</p><a class="contact-email" href={`mailto:${email}`}>hello.yuprananda@gmail.com <span>↗</span></a><a class="contact-button" href={`mailto:${email}`}><span data-en="Start a conversation" data-id="Mulai percakapan">Start a conversation</span><span>↗</span></a></div>
          </div>
        </section>
      </main>

      <footer class="site-footer section-wrap">
        <a class="footer-brand" href="#top"><span class="wordmark-mark">y.</span><span>YU PRANANDA</span></a>
        <span class="footer-note" data-en="Independent by choice. Collaborative by nature." data-id="Mandiri dalam berkarya. Kolaboratif dalam proses.">Independent by choice. Collaborative by nature.</span>
        <div class="footer-links"><a href={linkedIn} target="_blank" rel="noreferrer">LinkedIn ↗</a><a href={`mailto:${email}`}>Email ↗</a></div>
        <span class="footer-copy">© 2026</span>
      </footer>
    </div>
    <script src="../scripts/site.ts"></script>
  </body>
</html>
