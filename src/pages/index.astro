---
import '../styles/global.css';

const linkedIn = 'https://www.linkedin.com/in/yu-prananda-125116449/';
const email = 'hello.yuprananda@gmail.com';
const panels = [
  { id: 'intro', en: 'Intro', idText: 'Awal' },
  { id: 'about', en: 'About', idText: 'Tentang' },
  { id: 'work', en: 'Selected work', idText: 'Karya' },
  { id: 'contact', en: 'Contact', idText: 'Kontak' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#101116" />
    <meta name="description" content="Yu Prananda is an independent software engineer building full-stack products and practical business automation." />
    <meta property="og:title" content="Yu Prananda — Independent Software Engineer" />
    <meta property="og:description" content="I build software that makes complex work simpler. Full-stack engineering and practical business automation." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://yuprananda.github.io/" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Yu Prananda — Independent Software Engineer</title>
  </head>
  <body>
    <a class="skip-link" href="#portfolio" data-en="Skip to portfolio" data-id="Lewati ke portofolio">Skip to portfolio</a>
    <div class="portfolio-shell">
      <header class="site-header">
        <a class="brand" href="#intro" data-go-to="0" aria-label="Yu Prananda, intro" data-label-en="Yu Prananda, intro" data-label-id="Yu Prananda, awal">
          <span class="brand-mark">yu</span>
          <span class="brand-name">YU PRANANDA</span>
        </a>

        <nav class="panel-nav" aria-label="Portfolio panels" data-label-en="Portfolio panels" data-label-id="Panel portofolio">
          {panels.map((panel, index) => (
            <button
              class:list={["panel-nav-item", { "is-current": index === 0 }]}
              type="button"
              data-go-to={index}
              data-nav-en={`${String(index + 1).padStart(2, '0')} — ${panel.en}`}
              data-nav-id={`${String(index + 1).padStart(2, '0')} — ${panel.idText}`}
              aria-current={index === 0 ? 'step' : undefined}
              aria-label={`${String(index + 1).padStart(2, '0')} — ${panel.en}`}
            >
              <span class="panel-nav-number">{String(index + 1).padStart(2, '0')}</span>
              <span class="panel-nav-label" data-en={panel.en} data-id={panel.idText}>{panel.en}</span>
            </button>
          ))}
        </nav>

        <div class="header-tools">
          <span class="availability"><i></i><span data-en="Open to remote work" data-id="Terbuka untuk kerja remote">Open to remote work</span></span>
          <button class="language-toggle" type="button" aria-label="Switch language to Indonesian" aria-pressed="false">
            <span class="language-code">ID</span><span class="language-slash">/</span><span class="language-code language-code-active">EN</span>
          </button>
        </div>
      </header>

      <main id="portfolio" class="carousel" aria-roledescription="carousel" aria-label="Yu Prananda portfolio" data-label-en="Yu Prananda portfolio" data-label-id="Portofolio Yu Prananda">
        <div class="carousel-track" tabindex="0" aria-label="Use left and right arrow keys to change panels">
          <section class="panel panel-intro is-active" id="intro" data-slide-label-en="Introduction" data-slide-label-id="Awal" aria-roledescription="slide" aria-label="1 of 4: Introduction">
            <div class="panel-inner intro-inner">
              <div class="intro-copy panel-content">
                <p class="eyebrow"><span class="eyebrow-line"></span><span data-en="Independent software engineer · Indonesia" data-id="Software engineer independen · Indonesia">Independent software engineer · Indonesia</span></p>
                <h1 class="hero-name"><span>Yu</span><span>Prananda<span class="name-period">.</span></span></h1>
                <div class="hero-bottomline">
                  <p class="hero-statement" data-en="I build software that makes complex work simpler." data-id="Saya membangun software yang membuat pekerjaan rumit jadi lebih sederhana.">I build software that makes complex work simpler.</p>
                  <button class="text-link" type="button" data-go-to="2">
                    <span data-en="See selected work" data-id="Lihat karya pilihan">See selected work</span>
                    <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M4.5 12h14m-5.5-5.5L18.5 12 13 17.5" /></svg>
                  </button>
                </div>
              </div>

              <div class="identity-art" aria-hidden="true">
                <div class="identity-art-grid"></div>
                <div class="identity-frame frame-back"></div>
                <div class="identity-frame frame-front"></div>
                <div class="identity-mark">yu<span>.</span></div>
                <div class="identity-orbit orbit-one"></div>
                <div class="identity-orbit orbit-two"></div>
                <span class="art-coordinate coordinate-top">01° 37′ 00.0″ N</span>
                <span class="art-coordinate coordinate-bottom">BUILD WITH INTENTION</span>
                <span class="art-spark spark-one"></span><span class="art-spark spark-two"></span>
              </div>

              <div class="panel-index"><span>01</span><span class="index-rule"></span><span>04</span></div>
            </div>
          </section>

          <section class="panel panel-about" id="about" data-slide-label-en="About Yu" data-slide-label-id="Tentang Yu" aria-roledescription="slide" aria-label="2 of 4: About Yu">
            <div class="panel-inner about-inner">
              <div class="about-heading panel-content">
                <p class="eyebrow"><span class="eyebrow-line"></span><span>02 / </span><span data-en="A little about me" data-id="Tentang saya">A little about me</span></p>
                <h2><span data-en="Independent by practice." data-id="Mandiri dalam berkarya.">Independent by practice.</span><span class="heading-accent" data-en="Curious by default." data-id="Selalu ingin tahu.">Curious by default.</span></h2>
                <p class="about-copy" data-en="I’m Yu, an independent software engineer based in Indonesia. Since 2021, I’ve worked across full-stack development, business applications, and workflow automation—turning real operational needs into practical software." data-id="Saya Yu, software engineer independen dari Indonesia. Sejak 2021, saya mengerjakan pengembangan full-stack, aplikasi bisnis, dan otomasi workflow—mengubah kebutuhan operasional nyata menjadi software yang praktis.">I’m Yu, an independent software engineer based in Indonesia. Since 2021, I’ve worked across full-stack development, business applications, and workflow automation—turning real operational needs into practical software.</p>
              </div>

              <div class="craft-board panel-content" aria-label="Areas of work">
                <div class="craft-board-top"><span data-en="THINGS I WORK ON" data-id="YANG SAYA KERJAKAN">THINGS I WORK ON</span><span>03</span></div>
                <div class="craft-row"><span class="craft-number">01</span><span class="craft-name" data-en="Full-stack engineering" data-id="Full-stack engineering">Full-stack engineering</span><span class="craft-glyph glyph-build">↗</span></div>
                <div class="craft-row"><span class="craft-number">02</span><span class="craft-name" data-en="Business automation" data-id="Otomasi bisnis">Business automation</span><span class="craft-glyph glyph-automate"><i></i><i></i><i></i></span></div>
                <div class="craft-row"><span class="craft-number">03</span><span class="craft-name" data-en="Systems integration" data-id="Integrasi sistem">Systems integration</span><span class="craft-glyph glyph-connect">⤴</span></div>
                <div class="craft-board-foot"><span data-en="From first conversation to working software." data-id="Dari obrolan awal hingga software yang siap dipakai.">From first conversation to working software.</span><span>↗</span></div>
                <div class="craft-orbit craft-orbit-one"></div><div class="craft-orbit craft-orbit-two"></div>
              </div>

              <div class="about-foot"><span data-en="Based in East Kalimantan" data-id="Berbasis di Kalimantan Timur">Based in East Kalimantan</span><span class="foot-separator">/</span><span data-en="Working worldwide" data-id="Terbuka untuk kolaborasi global">Working worldwide</span><span class="tech-note">TS · React · Next.js · PostgreSQL · Prisma</span></div>
              <div class="panel-index"><span>02</span><span class="index-rule"></span><span>04</span></div>
            </div>
          </section>

          <section class="panel panel-work" id="work" data-slide-label-en="Selected work" data-slide-label-id="Karya pilihan" aria-roledescription="slide" aria-label="3 of 4: Selected work">
            <div class="panel-inner work-inner">
              <div class="work-heading panel-content">
                <p class="eyebrow"><span class="eyebrow-line"></span><span>03 / </span><span data-en="Selected work" data-id="Karya pilihan">Selected work</span></p>
                <h2><span data-en="Built for the" data-id="Dirancang untuk">Built for the</span><span class="heading-accent" data-en="everyday." data-id="keseharian.">everyday.</span></h2>
                <p class="work-summary" data-en="One example of practical software, shaped around the people who use it." data-id="Satu contoh software praktis yang dirancang sesuai kebutuhan orang-orang yang menggunakannya.">One example of practical software, shaped around the people who use it.</p>
              </div>

              <article class="project-feature panel-content">
                <div class="project-art" aria-hidden="true">
                  <div class="project-art-head"><span>B / SYSTEM STUDY</span><span>01—24</span></div>
                  <div class="workflow-map">
                    <div class="workflow-spine"></div>
                    <div class="workflow-node workflow-node-main"><span class="workflow-node-icon">b.</span><span class="workflow-node-label">WORKFORCE</span></div>
                    <div class="workflow-node workflow-node-eligibility"><span class="workflow-node-icon">✓</span><span class="workflow-node-label" data-en="ELIGIBILITY" data-id="KELAYAKAN">ELIGIBILITY</span></div>
                    <div class="workflow-node workflow-node-documents"><span class="workflow-node-icon">▤</span><span class="workflow-node-label" data-en="DOCUMENTS" data-id="DOKUMEN">DOCUMENTS</span></div>
                    <div class="workflow-node workflow-node-requests"><span class="workflow-node-icon">↗</span><span class="workflow-node-label" data-en="REQUESTS" data-id="PERMINTAAN">REQUESTS</span></div>
                    <span class="workflow-signal"></span>
                  </div>
                  <div class="project-art-caption"><span></span><span data-en="One dependable place for daily operations" data-id="Satu tempat andal untuk operasional harian">One dependable place for daily operations</span></div>
                </div>

                <div class="project-copy">
                  <div class="project-kicker"><span>BICLESS ERP</span><span data-en="WORKFORCE SYSTEM" data-id="SISTEM TENAGA KERJA">WORKFORCE SYSTEM</span></div>
                  <h3>Bicless ERP</h3>
                  <p data-en="I independently initiated and built a workforce management system to bring spreadsheets, documents, and everyday requests into one practical workflow. It now supports day-to-day operations." data-id="Saya menginisiasi dan membangun sistem manajemen tenaga kerja untuk menyatukan spreadsheet, dokumen, dan permintaan harian ke dalam satu workflow praktis. Sistem ini kini mendukung operasional sehari-hari.">I independently initiated and built a workforce management system to bring spreadsheets, documents, and everyday requests into one practical workflow. It now supports day-to-day operations.</p>
                  <div class="project-meta"><span data-en="MY ROLE" data-id="PERAN SAYA">MY ROLE</span><strong data-en="Independent engineer" data-id="Engineer independen">Independent engineer</strong></div>
                  <div class="project-tools"><span>TypeScript</span><span>Next.js</span><span>PostgreSQL</span><span>Prisma</span></div>
                </div>
              </article>

              <div class="panel-index"><span>03</span><span class="index-rule"></span><span>04</span></div>
            </div>
          </section>

          <section class="panel panel-contact" id="contact" data-slide-label-en="Contact Yu" data-slide-label-id="Kontak Yu" aria-roledescription="slide" aria-label="4 of 4: Contact Yu">
            <div class="panel-inner contact-inner">
              <div class="contact-copy panel-content">
                <p class="eyebrow"><span class="eyebrow-line"></span><span>04 / </span><span data-en="Your next idea starts here" data-id="Ide berikutnya dimulai di sini">Your next idea starts here</span></p>
                <h2><span data-en="Let’s make" data-id="Mari buat">Let’s make</span><span class="heading-accent" data-en="work better." data-id="pekerjaan lebih baik.">work better.</span></h2>
                <p class="contact-intro" data-en="Have a process worth improving or a product you want to bring to life? Tell me about it." data-id="Punya proses yang ingin diperbaiki atau produk yang ingin diwujudkan? Ceritakan kepada saya.">Have a process worth improving or a product you want to bring to life? Tell me about it.</p>
                <a class="contact-email" href={`mailto:${email}`}><span>{email}</span><span aria-hidden="true">↗</span></a>
                <a class="contact-cta" href={`mailto:${email}`}><span data-en="Start a conversation" data-id="Mulai percakapan">Start a conversation</span><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M4.5 12h14m-5.5-5.5L18.5 12 13 17.5" /></svg></a>
              </div>
              <div class="contact-art" aria-hidden="true"><span>YU</span><span class="contact-art-orbit"></span><span class="contact-art-dot"></span><span class="contact-art-caption">GOOD WORK, TOGETHER.</span></div>
              <div class="contact-links"><a href={linkedIn} target="_blank" rel="noreferrer">LinkedIn <span>↗</span></a><span>© 2026 Yu Prananda</span></div>
              <div class="panel-index"><span>04</span><span class="index-rule"></span><span>04</span></div>
            </div>
          </section>
        </div>

        <div class="carousel-controls" aria-label="Carousel controls">
          <button class="control-button previous-button" type="button" aria-label="Previous panel" data-label-en="Previous panel" data-label-id="Panel sebelumnya" disabled>
            <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M19.5 12h-14m5.5 5.5L5.5 12 11 6.5" /></svg>
          </button>
          <div class="progress-wrap"><span class="current-slide">01</span><div class="progress-track"><span class="progress-fill"></span></div><span class="total-slides">04</span></div>
          <button class="control-button next-button" type="button" aria-label="Next panel" data-label-en="Next panel" data-label-id="Panel berikutnya">
            <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M4.5 12h14m-5.5-5.5L18.5 12 13 17.5" /></svg>
          </button>
          <span class="swipe-hint" data-en="SWIPE OR USE ← →" data-id="GESER ATAU GUNAKAN ← →">SWIPE OR USE ← →</span>
        </div>
        <p class="sr-only" aria-live="polite" aria-atomic="true" id="slide-announcement">Slide 1 of 4: Introduction</p>
      </main>
    </div>
    <script src="../scripts/site.ts"></script>
  </body>
</html>
